<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B12">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:background="#99080B12">

        <Button
            android:id="@+id/pairing_scan_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#273045"
            android:text="@string/pairing_scan_cancel"
            android:textAllCaps="false"
            android:textColor="#F5F7FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pair device"
                android:textColor="#F5F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Scan the code from Pi Server Admin"
                android:textColor="#C4CAD8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/pairing_scan_torch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#7C9CFF"
            android:text="@string/pairing_scan_flash_on"
            android:textAllCaps="false"
            android:textColor="#081027" />
    </LinearLayout>
</FrameLayout>
